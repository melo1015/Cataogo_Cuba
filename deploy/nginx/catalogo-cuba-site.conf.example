# Plantilla de sitio para Nginx. Sustituir catalogo.example.com y las rutas
# de certificados antes de habilitarla. El archivo de zonas de rate limit
# catalogo-cuba-limits.conf debe cargarse en el contexto http {}.
#
# El proceso py4web debe escuchar solo en 127.0.0.1:8000 (o el socket privado
# elegido). No exponer el puerto de la aplicación en el firewall público.

upstream catalogo_cuba_app {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name catalogo.example.com;
    server_tokens off;

    # Certbot/ACME puede necesitar acceso a /.well-known/acme-challenge/.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name catalogo.example.com;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/catalogo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/catalogo.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:CatalogoTLS:10m;
    ssl_session_tickets off;

    client_max_body_size 3m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;
    limit_conn catalogo_per_ip 20;
    limit_req_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Limite más estricto para la creación pública de pedidos. El límite de
    # cuerpo coincide con MAX_ORDER_REQUEST_SIZE = 64 KiB en settings.py.
    location ~ ^/catalogo_cuba/api/negocio/[^/]+/pedidos$ {
        client_max_body_size 64k;
        limit_req zone=catalogo_orders burst=6 nodelay;
        proxy_pass http://catalogo_cuba_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Sobrescribir, no concatenar, cualquier X-Forwarded-For enviado por el cliente.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
    }

    # Límite general para APIs; los pedidos usan la regla más estricta anterior.
    location /catalogo_cuba/api/ {
        limit_req zone=catalogo_api burst=30 nodelay;
        proxy_pass http://catalogo_cuba_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
    }

    # Resto de páginas py4web. No se cachean aquí respuestas personalizadas.
    location / {
        proxy_pass http://catalogo_cuba_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_request_buffering on;
    }
}
